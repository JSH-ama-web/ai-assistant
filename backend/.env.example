# ── 필수 ─────────────────────────────────────────────
# 코디세이 콘솔(https://copa.codyssey.kr)에서 발급한 키 (절대 커밋 금지)
AI_API_KEY=

# Firebase 서비스 계정 키: 아래 둘 중 하나만 설정
#  1) JSON 전체 문자열 또는 base64 (Render 권장)
FIREBASE_SERVICE_ACCOUNT_JSON=
#  2) 로컬 개발용: 키 파일 경로
FIREBASE_CREDENTIALS_PATH=./serviceAccountKey.json

# CORS 허용 도메인 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://your-app.vercel.app

# ── 선택 ─────────────────────────────────────────────
# Gateway 주소 / 모델 (콘솔에 안내된 값으로)
AI_BASE_URL=https://copa.codyssey.kr
AI_MODEL=claude-haiku-4
# 비우면 Anthropic 형식 → 404/405 시 OpenAI 호환 형식 자동 전환. anthropic / openai 로 고정 가능
AI_API_FORMAT=
# 비용 보호: 응답 최대 토큰 / 대화 이력 반영 개수
AI_MAX_TOKENS=500
CHAT_HISTORY_LIMIT=10

# Firebase 키 없이 로컬 테스트할 때만 true (메모리 저장, 재시작 시 초기화)
USE_MEMORY_DB=false
